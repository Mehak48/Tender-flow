# TenderFlow configuration (all optional). Copy to `.env` in the repository root and edit.
# The backend reads TENDERFLOW_* keys from it at start-up; real environment variables take precedence.
# NEVER commit a real .env file — it is ignored by .gitignore.

# Where projects, uploaded files and exports are stored (default: backend/data).
TENDERFLOW_DATA_DIR=

# Maximum upload size in MB (1–200, default 25).
TENDERFLOW_MAX_UPLOAD_MB=25

# Browser origins allowed to call the API during development (comma-separated).
TENDERFLOW_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional: full path to LibreOffice's `soffice` executable for PDF export (auto-detected when empty).
TENDERFLOW_SOFFICE_PATH=

# ---------------------------------------------------------------------------
# Optional external AI provider (OFF by default).
# Only used for edit instructions that the built-in rules do not understand, and only after you also
# enable it in Settings → AI processing. Extraction, arithmetic, validation and export never use AI.
# What is sent: the instruction plus the quotation's non-company fields and line items (see docs/AI_POLICY.md).
# Uploaded files are never sent.
#
# Any OpenAI-compatible /chat/completions endpoint works, e.g. a local Ollama server:
#   TENDERFLOW_AI_PROVIDER=openai_compatible
#   TENDERFLOW_AI_BASE_URL=http://localhost:11434/v1
#   TENDERFLOW_AI_MODEL=llama3.1
# ---------------------------------------------------------------------------
TENDERFLOW_AI_PROVIDER=
TENDERFLOW_AI_BASE_URL=
TENDERFLOW_AI_MODEL=
# Leave empty for local servers that need no key. Placeholder only — put real keys in your own .env.
TENDERFLOW_AI_API_KEY=
TENDERFLOW_AI_TIMEOUT_S=20

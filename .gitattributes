# Normalise line endings: text files are stored with LF in the repository.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary formats: never touch line endings or try to diff them as text.
*.pdf binary
*.docx binary
*.xlsx binary
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
*.zip binary
